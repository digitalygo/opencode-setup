{
  "$schema": "https://opencode.ai/config.json",
  "default_agent": "orchestrator",
  "autoupdate": true,
  "compaction": {
    "auto": true,
    "prune": true,
    "preserve_recent_tokens": 50000,
  },
  "watcher": {
    "ignore": [
      "node_modules/**",
      "dist/**",
      ".git/**",
      "vendor/**",
      "venv/**",
      ".venv/**",
    ],
  },
  // tool output settings
  "tool_output": {
    "max_lines": 4000
  },
  // model selection
  "model": "openrouter/moonshotai/kimi-k3",
  "small_model": "openrouter/qwen/qwen3.7-flash",
  "instructions": [".github/CONTRIBUTING.md", "AGENTS.md"],
  "provider": {
    "openrouter": {
      "options": {
        "timeout": false,
        "chunkTimeout": 900000
      },
      "models": {
        "deepseek/deepseek-v4-flash-0731": {
          "limit": {
            "context": 1048576,
            "output": 384000
          },
          "options": {
            "provider": {
              "order": ["deepseek"],
              "allow_fallbacks": true
            }
          }
        },
        "deepseek/deepseek-v4-pro-0813": {
          "limit": {
            "context": 1048576,
            "output": 384000
          },
          "options": {
            "provider": {
              "order": ["deepseek"],
              "allow_fallbacks": true
            }
          }
        },
        "moonshotai/kimi-k3": {
          "limit": {
            "context": 1048576,
            "output": 131072
          },
          "options": {
            "provider": {
              "order": ["moonshotai"],
              "allow_fallbacks": true
            }
          }
        },
        "openai/gpt-5.6-luna": {
          "limit": {
            "context": 1050000,
            "output": 128000
          },
          "options": {
            "provider": {
              "order": ["openai"],
              "allow_fallbacks": true
            }
          }
        }
      }
    },
    "openai": {
      "options": {
        "timeout": false,
        "chunkTimeout": 900000
      }
    },
    "opencode": {
      "options": {
        "timeout": false,
        "chunkTimeout": 900000
      }
    },
    "opencode-go": {
      "options": {
        "timeout": false,
        "chunkTimeout": 900000
      }
    }
  },
  // pre-configured mcp servers
  "mcp": {
    "figma": {
      "type": "local",
      "command": [
        "npx",
        "-y",
        "figma-developer-mcp",
        "--figma-api-key={file:~/Documents/.secrets/figma-token}",
        "--stdio",
      ],
      "enabled": true,
    },
    // remove "--headless=true" to the command if you want to use chrome with a GUI
    "chrome-devtools": {
      "type": "local",
      "command": ["npx", "-y", "chrome-devtools-mcp@latest", "--headless=true"],
      "enabled": true,
    },
  },
  // default CLI permissions
  "permission": {
    "external_directory": {
      "*": "deny",
      "~/.config/opencode/**": "allow",
      "~/Documents/**": "allow"
    },
    "read": {
      ".env": "deny",
      "*/.env": "deny",
      ".env.*": "deny",
      "*/.env.*":"deny",
      ".env*.example":"allow",
      "*/.env*.example":"allow"
    },
    "doom_loop": "deny",
    "bash": {
      "*": "allow",
      "rm -rf /": "deny",
      "rm -rf ~": "deny",
      "find / -delete": "deny",
      "find /* -delete": "deny",
      "command > /dev/sda": "deny",
      "command > /dev/nvme*": "deny",
      "* > /dev/sd*": "deny",
      "* > /dev/nvme*": "deny",
      "dd if=/dev/zero of=/dev/sd*": "deny",
      "dd if=/dev/zero of=/dev/nvme*": "deny",
      "mkfs.* /dev/sd*": "deny",
      "mkfs.* /dev/nvme*": "deny",
      "mkfs.* /dev/loop*": "deny",
      ":(){ :|:& };:": "deny",
      "sudo su *": "deny",
      "sudo -i": "deny",
      "sudo -u#-1": "deny",
      "sudo chmod 777 /": "deny",
      "sudo chown *": "deny",
      "chmod -R 777 /": "deny",
      "chmod +s *": "deny",
      "chattr -i *": "deny",
      "crontab -e": "deny",
      "crontab *": "deny",
      "echo * >> /etc/crontab": "deny",
      "touch /etc/cron.d/*": "deny",
      "cat /etc/shadow": "deny",
      "cat /root/.ssh/id_rsa": "deny",
      "cat ~/.ssh/authorized_keys": "deny",
      "cat /proc/self/environ": "deny",
      "wget * | sh": "deny",
      "curl * | bash": "deny",
      "curl * | sh": "deny",
      "nc -e *": "deny",
      "bash -i >& /dev/tcp/*": "deny",
      "python -c * /dev/tcp/*": "deny",
      "scp *": "deny",
      "rsync *": "deny",
      "nmap *": "deny",
      "traceroute *": "deny",
      "iptables *": "deny",
      "echo * >> /etc/hosts": "deny",
      "docker run --privileged *": "deny",
      "docker run -v /:/host*": "deny",
      "shutdown *": "deny",
      "reboot": "deny",
      "poweroff": "deny",
      "systemctl reboot": "deny",
      "systemctl poweroff": "deny",
      "kill -9 -1": "deny",
      "yes > /dev/null": "deny",
      "stress *": "deny",
      "eval *": "deny",
      "git commit": "ask",
      "git commit *": "ask",
      "git push": "ask",
      "git push *": "ask"
    },
  },
}
